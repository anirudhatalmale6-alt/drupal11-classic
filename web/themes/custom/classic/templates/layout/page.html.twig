{#
/**
 * @file
 * Page layout for the Classic theme.
 *
 * The header is a single row: brand on the left, primary menu on the right,
 * collapsing to a disclosure button below 62rem.
 */
#}
<div class="classic-page">

  {{ page.page_top }}

  <header class="classic-header" role="banner">
    <div class="classic-shell classic-header__inner">

      <a href="{{ front_page }}" class="classic-brand" rel="home">
        {% if logo %}
          <img src="{{ logo }}" alt="" class="classic-brand__mark" width="36" height="36">
        {% endif %}
        <span>
          <span class="classic-brand__name">{{ site_name }}</span>
          {% if site_slogan %}
            <span class="classic-brand__slogan">{{ site_slogan }}</span>
          {% endif %}
        </span>
      </a>

      {% if page.primary_menu or page.header %}
        <nav class="classic-nav" role="navigation" aria-label="{{ 'Primary navigation'|t }}">
          <button type="button"
                  class="classic-nav__toggle"
                  data-classic-nav-toggle
                  aria-expanded="false"
                  aria-controls="classic-nav-panel">
            {{ 'Menu'|t }}
          </button>
          <div class="classic-nav__panel" id="classic-nav-panel" data-classic-nav-panel hidden>
            {{ page.primary_menu }}
            {{ page.header }}
          </div>
        </nav>
      {% endif %}

    </div>
  </header>

  {% if page.hero %}
    <div class="classic-hero">
      <div class="classic-shell">
        {{ page.hero }}
      </div>
    </div>
  {% endif %}

  <main class="classic-main" role="main">
    <a id="main-content" tabindex="-1"></a>

    <div class="classic-shell">

      {% if page.breadcrumb %}
        <div class="classic-breadcrumb">{{ page.breadcrumb }}</div>
      {% endif %}

      {{ page.highlighted }}

      <div class="classic-main__grid{{ page.sidebar ? ' classic-main__grid--with-sidebar' }}">
        <div class="classic-main__content">
          {{ page.content_above }}
          {{ page.content }}
          {{ page.content_below }}
        </div>

        {% if page.sidebar %}
          <aside class="classic-sidebar" role="complementary">
            {{ page.sidebar }}
          </aside>
        {% endif %}
      </div>

    </div>
  </main>

  <footer class="classic-footer" role="contentinfo">
    <div class="classic-shell">
      {% if page.footer_first or page.footer_second or page.footer_third %}
        <div class="classic-footer__columns">
          {{ page.footer_first }}
          {{ page.footer_second }}
          {{ page.footer_third }}
        </div>
      {% endif %}
      <div class="classic-footer__bottom">
        {% if page.footer_bottom %}
          {{ page.footer_bottom }}
        {% else %}
          &copy; {{ 'now'|date('Y') }} {{ site_name }}
        {% endif %}
      </div>
    </div>
  </footer>

  {{ page.page_bottom }}

</div>
